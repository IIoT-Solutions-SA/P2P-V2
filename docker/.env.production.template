# Copy to docker/.env on the deployment host and replace every placeholder.
# Never commit docker/.env. Passwords used in connection URLs need both their
# literal and URL-encoded forms. Keep values consistent per pair.
P2P_POSTGRES_PASSWORD=replace-with-strong-url-safe-password
P2P_POSTGRES_PASSWORD_URLENCODED=replace-with-URL-encoded-postgres-password
P2P_MONGO_PASSWORD=replace-with-strong-url-safe-password
P2P_MONGO_PASSWORD_URLENCODED=replace-with-URL-encoded-mongo-password
P2P_SECRET_KEY=replace-with-at-least-32-random-bytes
