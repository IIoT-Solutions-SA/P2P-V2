# Backend environment template
# Copy to .env and fill in values.

ENVIRONMENT=development

# Email Configuration - Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Email verification behavior
EMAIL_VERIFICATION_SEND=false     # Send verification emails on signup
DEV_EMAIL_VERIFICATION_ENDPOINT=true  # Expose dev /verify endpoint
DEV_SEND_EMAILS=true              # Send transactional emails (OTP, invites, etc.)