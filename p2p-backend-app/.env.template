# Backend environment template
# Copy to .env and fill in values.

ENVIRONMENT=development

# Email Configuration - Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Email verification behavior
EMAIL_VERIFICATION_SEND=false     # Send SuperTokens verification-link emails on signup
DEV_EMAIL_VERIFICATION_ENDPOINT=true  # Expose dev /verify endpoint only in development
DEV_SEND_EMAILS=false             # Development default: do not send transactional emails; codes/links stay local