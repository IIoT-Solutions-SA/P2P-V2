# Backend environment template
# Copy to .env and fill in values.

ENVIRONMENT=development

# Session controls (KACST baseline)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=8

# Failed-login protection (KACST baseline)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Email Configuration - Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Email verification behavior
EMAIL_VERIFICATION_SEND=false     # Send SuperTokens verification-link emails on signup
DEV_EMAIL_VERIFICATION_ENDPOINT=true  # Expose dev /verify endpoint only in development
DEV_SEND_EMAILS=false             # Development default: do not send transactional emails; codes/links stay local